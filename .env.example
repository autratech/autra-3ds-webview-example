# Copie para .env e preencha. NUNCA commite o .env.
AUTRA_BASE_URL=https://api.sandbox.autra.io
AUTRA_CLIENT_ID=
AUTRA_CLIENT_SECRET=
AUTRA_DOCUMENT_ID=67757775000187
PORT=3000
# URL pública que a Cardinal chama (form POST) ao fim do desafio.
# Em produção precisa ser https e acessível pela internet.
PUBLIC_RETURN_URL=http://localhost:3000/api/3ds/return
# Origin exata do checkout. Omitido = origin de PUBLIC_RETURN_URL.
PUBLIC_CHECKOUT_ORIGIN=
# Opt-in após a Autra habilitar chave/origin do tenant no sandbox. Exige HTTPS.
SANDBOX_RETURN_CALLBACK=false
# Proxies confiáveis por IP/CIDR, separados por vírgula. Vazio ignora X-Forwarded-For.
TRUSTED_PROXY=
